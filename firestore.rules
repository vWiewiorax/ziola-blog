rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // UID właściciela bloga — jedyne konto z prawem zapisu.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'W1VpatvhZKaG9ONkoTVNMF8F2DV2';
    }

    function validPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 120
        && data.excerpt is string && data.excerpt.size() <= 400
        && data.content is string && data.content.size() <= 100000
        && data.category is string && data.category.size() <= 60
        && data.date is string
        && data.published is bool;
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isOwner();
      allow create, update: if isOwner() && validPost(request.resource.data);
      allow delete: if isOwner();
    }

    match /messages/{messageId} {
      // Każdy może wysłać wiadomość z formularza, ale nikt poza właścicielem jej nie odczyta.
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt']);
      allow read, update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
